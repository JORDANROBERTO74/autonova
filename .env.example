# Número de WhatsApp en formato internacional, solo dígitos (ej. 5215512345678).
NEXT_PUBLIC_WHATSAPP_NUMBER=5215500000000

# Origen público del sitio (metadatos y URLs absolutas).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Acceso local al panel. Estos valores son visibles en el bundle del cliente.
NEXT_PUBLIC_ADMIN_EMAIL=admin@autonova.mx
NEXT_PUBLIC_ADMIN_PASSWORD=autonova2026
